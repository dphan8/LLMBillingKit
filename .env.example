# LLMBillingKit does not require environment variables by default.
# These placeholders are provided for future optional integrations and local testing.

# Provider keys used by your own SDK calls (not required by LLMBillingKit internals)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional future override if configurable DB path support is added
LLMBILLINGKIT_DB_PATH=/absolute/path/to/usage.db
