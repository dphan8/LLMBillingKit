OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLMBillingKit internal configuration
# Defaults to ~/.LLMBillingKit/usage.db
# LLMBILLINGKIT_DB_PATH=/absolute/path/to/usage.db

